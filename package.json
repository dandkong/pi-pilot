{
  "name": "pi-pilot",
  "version": "0.1.0",
  "description": "Telegram bot that wraps the pi coding agent for remote programming",
  "bin": {
    "pi-pilot": "./index.ts"
  },
  "module": "index.ts",
  "type": "module",
  "scripts": {
    "start": "bun run index.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.86.1",
    "grammy": "^1.46.0",
    "remend": "^1.3.1"
  },
  "overrides": {
    "ws": "^8.21.3",
    "brace-expansion": "^5.0.9",
    "protobufjs": "^7.6.6"
  },
  "trustedDependencies": [
    "@google/genai",
    "esbuild",
    "koffi",
    "protobufjs"
  ]
}
