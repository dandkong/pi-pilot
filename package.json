{
  "name": "pi-pilot",
  "version": "0.1.0",
  "description": "Telegram bot that wraps the pi coding agent for remote programming",
  "bin": {
    "pi-pilot": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "packageManager": "pnpm@10.31.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "^24",
    "tsx": "^4.22.4",
    "typescript": "^5"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.80.2",
    "dotenv": "^17.4.2",
    "grammy": "^1.44.0",
    "remend": "^1.3.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@google/genai",
      "esbuild",
      "koffi",
      "protobufjs"
    ]
  }
}
