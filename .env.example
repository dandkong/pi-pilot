# Copy to <workspace>/pi-pilot/config/.env.
# Launch with --workspaces <workspace>, or PI_PILOT_WORKSPACES in your shell.
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to interact. Empty denies all users.
TELEGRAM_ALLOWED_USERS=
# Optional default chat for all bot output. Falls back to the first allowed user.
TELEGRAM_DEFAULT_CHAT_ID=
# Provider keys can be stored here, in auth.json, or supplied by the process.
DEEPSEEK_API_KEY=
