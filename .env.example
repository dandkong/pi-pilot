TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to interact. Empty denies all users.
TELEGRAM_ALLOWED_USERS=
# Optional default chat for all bot output. Falls back to the first allowed user.
TELEGRAM_DEFAULT_CHAT_ID=
# Optional comma-separated workspace paths. First path is the default workspace.
# If unset, pi-pilot uses the process cwd.
PI_PILOT_WORKSPACES=
# debug, info, warn, error, silent
PI_PILOT_LOG_LEVEL=info
# Initial model for a new workspace, using provider/model-id. Optional.
PI_PILOT_MODEL=
# Provider credentials come from environment variables, not pi auth.json.
# Example: select an Anthropic model with /models after setting this key.
ANTHROPIC_API_KEY=
# Durable storage (default: ~/.pi/pilot/durable). Keep this across restarts.
PI_PILOT_DATA_DIR=
