TELEGRAM_BOT_TOKEN=
# Optional comma-separated Telegram user IDs. Empty allows all users.
TELEGRAM_ALLOWED_USERS=
# Optional. Defaults to the process cwd locally; Docker/Compose defaults to /workspace.
PI_PILOT_CWD=
# Optional comma-separated workspace paths. PI_PILOT_CWD is always included first.
PI_PILOT_WORKSPACES=
# debug, info, warn, error, silent
PI_PILOT_LOG_LEVEL=info
